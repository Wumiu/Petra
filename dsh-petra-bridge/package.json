{
  "name": "dsh-petra-bridge",
  "version": "0.1.0",
  "description": "Expose a local /petra/ask endpoint so Petra can forward text/video links to a running DSH session.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": ["dsh", "dsh-plugin", "petra"]
}
